<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Mode Theme -->
    <style name="Base.Theme.NaikApa" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorError">@color/colorError</item>

        <!-- Window & Background -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>

        <!-- Status bar & Navigation bar — dark icons off for dark mode -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">@color/colorPrimaryLight</item>
        <item name="rippleColor">@color/colorPrimaryLight</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/colorTextHint</item>

        <!-- Surface Colors -->
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>

        <!-- Material Components default styles -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.NaikApa.BottomSheetDialog</item>
        <item name="chipStyle">@style/Widget.Material3.Chip.Filter</item>
        <item name="snackbarStyle">@style/Widget.Material3.Snackbar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="floatingActionButtonStyle">@style/Widget.Material3.FloatingActionButton.Primary</item>
        <item name="tabStyle">@style/Widget.Material3.TabLayout</item>
    </style>
</resources>
