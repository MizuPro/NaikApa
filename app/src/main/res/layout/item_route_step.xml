<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Timeline: line top -->
    <View
        android:id="@+id/viewLineTop"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/colorConnectorLine"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardDot"
        app:layout_constraintStart_toStartOf="@id/cardDot"
        app:layout_constraintEnd_toEndOf="@id/cardDot" />

    <!-- Timeline: dot -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="18dp"
        app:cardElevation="0dp"
        app:cardCornerRadius="7dp"
        app:cardBackgroundColor="@color/colorAccentOrange"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Timeline: line bottom -->
    <View
        android:id="@+id/viewLineBottom"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/colorConnectorLine"
        app:layout_constraintTop_toBottomOf="@id/cardDot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/cardDot"
        app:layout_constraintEnd_toEndOf="@id/cardDot" />

    <!-- Step Icon Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:layout_constraintTop_toTopOf="@id/cardDot"
        app:layout_constraintBottom_toBottomOf="@id/cardDot"
        app:layout_constraintStart_toEndOf="@id/cardDot">

        <ImageView
            android:id="@+id/ivStepIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_walk"
            app:tint="@color/colorAccentOrange"
            android:contentDescription="@null" />
    </androidx.cardview.widget.CardView>

    <!-- Step Text Content -->
    <LinearLayout
        android:id="@+id/layoutStepContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvStepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Jalan Kaki ke Stasiun Sudirman" />

        <TextView
            android:id="@+id/tvStepDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            android:maxLines="4"
            android:ellipsize="end"
            tools:text="Jarak 250 m • Durasi 3 mnt" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
