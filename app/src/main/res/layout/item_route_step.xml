<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Timeline left panel -->
    <View
        android:id="@+id/viewLineTop"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="#DDDDDD"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardDot"
        app:layout_constraintStart_toStartOf="@id/cardDot"
        app:layout_constraintEnd_toEndOf="@id/cardDot" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardDot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="16dp"
        app:cardElevation="0dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="#FFA500"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/viewLineBottom"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="#DDDDDD"
        app:layout_constraintTop_toBottomOf="@id/cardDot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/cardDot"
        app:layout_constraintEnd_toEndOf="@id/cardDot" />

    <!-- Step Icon Container (Rounded) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#F8F9FA"
        app:layout_constraintTop_toTopOf="@id/cardDot"
        app:layout_constraintBottom_toBottomOf="@id/cardDot"
        app:layout_constraintStart_toEndOf="@id/cardDot">

        <ImageView
            android:id="@+id/ivStepIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            app:tint="#FFA500" />
    </androidx.cardview.widget.CardView>

    <!-- Step Text Content -->
    <TextView
        android:id="@+id/tvStepTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#333333"
        tools:text="Jalan Kaki ke Stasiun Sudirman"
        app:layout_constraintTop_toTopOf="@id/cardIcon"
        app:layout_constraintStart_toEndOf="@id/cardIcon"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvStepDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:textColor="#777777"
        tools:text="Jarak 250 m • Durasi 3 mnt"
        app:layout_constraintTop_toBottomOf="@id/tvStepTitle"
        app:layout_constraintStart_toStartOf="@id/tvStepTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
