<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".presentation.home.HomeFragment">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Peta osmdroid sebagai background utama -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Header Bar Premium di bagian atas -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Logo Teks Samping -->
            <ImageView
                android:id="@+id/imgLogoHeader"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/logo_textsamping"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <!-- User Welcome Info (Hidden or short) -->
            <TextView
                android:id="@+id/tvWelcomeUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Halo, Guest!"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgLogoHeader"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Notification Icon with Badge -->
            <FrameLayout
                android:id="@+id/btnNotification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="#F1F5F9"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cardAvatar"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/colorTextPrimary"
                    tools:ignore="ContentDescription" />

                <!-- Badge Notifikasi Merah -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_notification_dot" />

            </FrameLayout>

            <!-- User Avatar Circle -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/colorPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    app:tint="@color/colorTextSecondary"
                    tools:ignore="ContentDescription" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Tombol Tampilkan Panel (muncul saat cardSearch di-hide) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShowPanel"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:minHeight="0dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/btn_show_panel"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@color/white"
        app:cornerRadius="18dp"
        app:icon="@drawable/ic_directions"
        app:iconSize="14dp"
        app:iconTint="@color/colorPrimary"
        app:iconPadding="4dp"
        android:textColor="@color/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/cardHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 3. Floating Search Card (Tengah-Atas) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorCardOutline"
        app:layout_constraintTop_toBottomOf="@id/cardHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tombol Collapse/Expand Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCollapsePanel"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/btn_hide_panel"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_close"
                    app:iconGravity="textEnd"
                    app:iconSize="14dp"
                    app:iconTint="@color/colorTextSecondary"
                    app:iconPadding="4dp" />
            </LinearLayout>

            <!-- Konten yang bisa di-collapse -->
            <LinearLayout
                android:id="@+id/layoutPanelContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Route Inputs Container with connection line and swap button -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Left Connection Dots & Line -->
                <View
                    android:id="@+id/dotStart"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_dot_origin"
                    app:layout_constraintBottom_toTopOf="@id/lineConnector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/layoutOriginField" />

                <View
                    android:id="@+id/lineConnector"
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:background="#CBD5E1"
                    app:layout_constraintBottom_toTopOf="@id/dotEnd"
                    app:layout_constraintEnd_toEndOf="@id/dotStart"
                    app:layout_constraintStart_toStartOf="@id/dotStart"
                    app:layout_constraintTop_toBottomOf="@id/dotStart" />

                <View
                    android:id="@+id/dotEnd"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_notification_dot"
                    app:layout_constraintBottom_toBottomOf="@id/layoutDestinationField"
                    app:layout_constraintEnd_toEndOf="@id/dotStart"
                    app:layout_constraintStart_toStartOf="@id/dotStart"
                    app:layout_constraintTop_toBottomOf="@id/lineConnector" />

                <!-- Origin Field Layout -->
                <LinearLayout
                    android:id="@+id/layoutOriginField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toStartOf="@id/btnSwap"
                    app:layout_constraintStart_toEndOf="@id/dotStart"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_dari"
                        android:textColor="@color/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrigin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/search_dari_val"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOriginSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/search_dari_sub"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilOriginSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/search_origin_hint"
                        android:visibility="gone"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/colorPrimary"
                        app:startIconDrawable="@drawable/ic_my_location">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOriginSearch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <View
                    android:id="@+id/dividerSearch"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/colorBorder"
                    app:layout_constraintBottom_toTopOf="@id/layoutDestinationField"
                    app:layout_constraintEnd_toEndOf="@id/layoutOriginField"
                    app:layout_constraintStart_toStartOf="@id/layoutOriginField"
                    app:layout_constraintTop_toBottomOf="@id/layoutOriginField" />

                <!-- Destination Field Layout -->
                <LinearLayout
                    android:id="@+id/layoutDestinationField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toStartOf="@id/btnSwap"
                    app:layout_constraintStart_toEndOf="@id/dotEnd"
                    app:layout_constraintTop_toBottomOf="@id/dividerSearch">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_tujuan"
                        android:textColor="@color/colorAmber"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDestination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/search_tujuan_val"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDestinationSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/search_tujuan_sub"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDestinationSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/search_destination_hint"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/colorAccentOrange"
                        app:startIconDrawable="@drawable/ic_directions">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDestinationSearch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Floating Round Swap Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSwap"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:cardBackgroundColor="#F1F5F9"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_swap"
                        app:tint="@color/colorTextPrimary"
                        tools:ignore="ContentDescription" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvSearchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="@string/search_destination_loading"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/layoutSearchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="@color/colorBorder" />

            <!-- Horizontal Transit Modes Scroll -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Pilihan Moda"
                android:textColor="@color/colorTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/scrollTransitModes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupModes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    app:singleSelection="true"
                    app:singleLine="true">
                    
                    <com.google.android.material.chip.Chip
                        android:id="@+id/modeCampur"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Campur"
                        app:chipIcon="@drawable/ic_directions"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modeTJ"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TransJakarta"
                        app:chipIcon="@drawable/ic_bus" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modeKRL"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KRL"
                        app:chipIcon="@drawable/ic_train" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modeMRT"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MRT"
                        app:chipIcon="@drawable/ic_train" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modeLRT"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LRT"
                        app:chipIcon="@drawable/ic_train" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modeMotor"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Motor"
                        app:chipIcon="@drawable/ic_motorcycle" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/modeMobil"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobil"
                        app:chipIcon="@drawable/ic_car" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Horizontal Route Criteria Scroll -->
            <HorizontalScrollView
                android:id="@+id/scrollRouteCriteria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCriteria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    app:singleSelection="true"
                    app:singleLine="true">

                    <!-- Tercepat (Active) -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTercepat"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:checked="true"
                        android:text="Tercepat"
                        app:chipMinHeight="32dp"
                        app:chipCornerRadius="16dp"
                        app:chipStrokeWidth="0dp"
                        app:chipBackgroundColor="@color/colorAccentOrangeLight"
                        android:textColor="@color/colorAmber" />

                    <!-- Terhemat -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTerhemat"
                        style="@style/Widget.Material3.Chip.Filter.Elevated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="Terhemat"
                        app:chipMinHeight="32dp"
                        app:chipCornerRadius="16dp"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/colorCardOutline"
                        android:textColor="@color/colorTextPrimary" />

                    <!-- Minim Jalan Kaki -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMinimJalanKaki"
                        style="@style/Widget.Material3.Chip.Filter.Elevated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="Minim Jalan Kaki"
                        app:chipMinHeight="32dp"
                        app:chipCornerRadius="16dp"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/colorCardOutline"
                        android:textColor="@color/colorTextPrimary" />

                    <!-- Minim Transit -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMinimTransit"
                        style="@style/Widget.Material3.Chip.Filter.Elevated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minim Transit"
                        app:chipMinHeight="32dp"
                        app:chipCornerRadius="16dp"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/colorCardOutline"
                        android:textColor="@color/colorTextPrimary" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <!-- Temukan Rute Orange Button dengan Progress State -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTemukanRute"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/btn_temukan_rute"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorAccentOrange"
                    app:cornerRadius="10dp" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressRouteSearch"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/colorAccentOrange"
                    app:trackThickness="3dp" />
            </FrameLayout>

            </LinearLayout><!-- end layoutPanelContent -->

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMapStyle"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/map_style_light"
        android:textColor="@color/colorPrimary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="@color/white"
        app:cornerRadius="21dp"
        app:layout_constraintBottom_toTopOf="@id/btnLocation"
        app:layout_constraintEnd_toEndOf="parent"
        app:strokeColor="@color/colorCardOutline"
        app:strokeWidth="1dp" />

    <!-- 4. Floating GPS Location Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnLocation"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/location_button_description"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/cardRecommendation"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_my_location"
            app:tint="@color/colorPrimary"
            tools:ignore="ContentDescription" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 5. Bottom Recommendation Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRecommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="120dp"
        app:behavior_hideable="false"
        
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/colorCardOutline"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">
            <!-- Drag Handle -->
            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_bottom_sheet_handle" />


            <!-- Header: Judul + label prioritas + tombol tutup -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rekomendasi_terbaik"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPriorityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/colorAccentOrangeLight"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tvPriorityLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/colorAmber"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        tools:text="TERCEPAT" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Tombol tutup / reset rekomendasi -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseRecommendation"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:visibility="gone"
                    app:icon="@drawable/ic_close"
                    app:iconSize="18dp"
                    app:iconTint="@color/colorTextSecondary"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

            </LinearLayout>

            <!-- Empty State TextView -->
            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="@string/home_empty_state_text"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:visibility="visible" />

            <!-- Scrollable Wrapper untuk RecyclerView agar tidak overflow -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollRecommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="300dp"
                android:visibility="gone"
                android:fillViewport="true">

                <!-- RecyclerView untuk daftar rekomendasi -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_route_recommendation" />

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
