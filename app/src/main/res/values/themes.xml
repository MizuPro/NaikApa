<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NaikApa" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorError">@color/colorError</item>

        <!-- Window & Background -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>

        <!-- Status bar & Navigation bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">@color/colorPrimaryLight</item>
        <item name="rippleColor">@color/colorPrimaryLight</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:textColorHint">@color/colorTextHint</item>

        <!-- Surface Colors -->
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>

        <!-- Material Components default styles -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.NaikApa.BottomSheetDialog</item>
        <item name="chipStyle">@style/Widget.Material3.Chip.Filter</item>
        <item name="snackbarStyle">@style/Widget.Material3.Snackbar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="floatingActionButtonStyle">@style/Widget.Material3.FloatingActionButton.Primary</item>
        <item name="tabStyle">@style/Widget.Material3.TabLayout</item>
    </style>

    <style name="ThemeOverlay.NaikApa.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Material3.BottomSheet.Modal</item>
    </style>

    <!-- Theme overlay untuk Card agar tidak terkena efek tint elevation Material 3 -->
    <style name="ThemeOverlay.NaikApa.WhiteCard" parent="">
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- Theme overlay untuk input field agar tetap menggunakan warna primary asli meskipun berada di dalam WhiteCard -->
    <style name="ThemeOverlay.NaikApa.SearchInput" parent="">
        <item name="colorPrimary">@color/colorPrimary</item>
    </style>

    <style name="Theme.NaikApa" parent="Base.Theme.NaikApa" />
</resources>
